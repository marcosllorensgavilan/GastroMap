# Copia este archivo a .env (sin el ".example") y pon tu clave real ahí.
# NUNCA subas el archivo .env de verdad a GitHub ni lo compartas — es tu
# clave de pago real. El .gitignore ya está configurado para ignorarlo.

ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# Opcional — cuántas consultas de IA gratis puede hacer cada persona al día
# antes de que se le corte hasta el día siguiente. Por defecto: 20.
DAILY_AI_LIMIT=20

# Opcional — dónde se guardan las cuentas de usuario y reseñas (app.sqlite).
# Déjalo vacío para pruebas locales (se guarda junto al código).
# En producción, ponlo a la ruta de un disco persistente (p.ej. /var/data en
# Render con un Disk montado) — si no, las cuentas se borrarían en cada
# despliegue nuevo.
DATA_DIR=
